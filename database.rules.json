{
  "rules": {
    "config": {
      "adminEmails": {
        ".read": "auth != null",
        ".write": "false"
      }
    },
    "wishlists": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "categories": {
      ".read": "true",
      ".write": "auth != null && root.child('config/adminEmails').child(auth.token.email.replace('.', ',')).exists()"
    },
    "products": {
      ".read": "true",
      ".write": "auth != null && root.child('config/adminEmails').child(auth.token.email.replace('.', ',')).exists()"
    },
    "slider": {
      ".read": "true",
      ".write": "auth != null && root.child('config/adminEmails').child(auth.token.email.replace('.', ',')).exists()"
    },
    "footer": {
      ".read": "true",
      ".write": "auth != null && root.child('config/adminEmails').child(auth.token.email.replace('.', ',')).exists()"
    }
  }
}